# Copy to /etc/core8/lead-agent.env on the server, fill in, then: chmod 600.
# This file holds secrets. It must never be committed or pasted into a chat.

# Public address of the agent (must match the Caddy site block).
CORE8_PILOT_PUBLIC_HOST=agent.core8-ai.io

# No password here. Set it on the server after the container is up:
#   docker exec -it core8-lead-agent node tools/set-password.cjs

# The same secret as "secret" in the website's server/lead-config.php.
CORE8_LEAD_SECRET=

# Read-only mailbox access. Use a Gmail APP PASSWORD (needs 2-step verification),
# never the normal account password.
CORE8_PILOT_IMAP_USER=
CORE8_PILOT_IMAP_PASS=
CORE8_PILOT_IMAP_MINUTES=5

# Optional live model. Leave empty to use the offline rules engine.
# CORE8_PILOT_ENGINE=anthropic
# ANTHROPIC_API_KEY=
