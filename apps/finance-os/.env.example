# NEVER commit actual credentials or financial data.
# Local sandbox webhook signing secret from Stripe CLI forwarding, not production.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_sandbox_secret
APP_ENV=sandbox
ENABLE_STRIPE_WRITES=false
STRIPE_EXPECT_LIVEMODE=false
# Required for single-merchant sandbox webhook binding; provision only after
# independently verifying the Stripe account belongs to the configured tenant.
FINANCE_WEBHOOK_ACCOUNT_ID=acct_replace_with_verified_sandbox_account
FINANCE_WEBHOOK_TENANT_ID=replace_with_verified_tenant_id
