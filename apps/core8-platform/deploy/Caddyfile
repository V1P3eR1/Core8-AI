{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 320MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	@api path /api/* /media/* /ws /ws/*
	handle @api {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# Extra sites served by this same Caddy (other Core8 services on this VPS).
# Drop one *.caddy file per site into deploy/sites/ on the server; an empty
# folder is fine. Those files are local to the server and not tracked in git.
import /etc/caddy/sites/*.caddy
