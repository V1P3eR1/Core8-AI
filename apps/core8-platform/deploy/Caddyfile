# ⚠ Source of truth is git (V1P3eR1/Core8-AI, main). Do NOT edit this file on the VPS:
#   local edits block `git pull` and are lost on the next deploy. Change it in a PR, then redeploy.
#   (2026-11-19 and 2026-11-20 edits made on the server were recovered into PRs #44 and #57.)
{$DOMAIN} {$EXTRA_DOMAINS} {
	encode zstd gzip
	request_body {
		max_size 320MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	@api path /api/* /media/* /ws /ws/*
	handle @api {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# Lead agent (apps/lead-triage-pilot), reached over the external core8-edge network.
# Added on the VPS by the lead-agent session on 2026-11-19; recorded here so redeploys keep it.
agent.core8-ai.io {
	encode gzip
	reverse_proxy lead-agent:4180
}

# core8-ai.io serves the new landing page until core8-ai.com is transferred to Lev
# (decision 2026-11-21; replaces the redirect to the old ETX site on core8-ai.com).
# The page is the core8-landing project; its form posts to the lead agent, which on
# these hosts answers only POST /api/public/lead (everything else there is 404).
core8-ai.io, www.core8-ai.io {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	request_body {
		max_size 16KB
	}
	handle /api/public/lead {
		reverse_proxy lead-agent:4180
	}
	handle {
		reverse_proxy core8-landing:8080
	}
}
