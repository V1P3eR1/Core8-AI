{
  "version": "1.0.0",
  "title": "Core8 Smart Discovery Questionnaire",
  "intake": {
    "id": "exec",
    "title": "Executive intake",
    "questions": [
      {"id": "exec.company_name", "text": "Company name", "type": "text", "required": true,
       "sensitivity": "public", "maps_to": {"category": "organization_profile", "key": "company_name"}},
      {"id": "exec.industry", "text": "Industry", "type": "text", "required": true,
       "sensitivity": "public", "maps_to": {"category": "organization_profile", "key": "industry"}},
      {"id": "exec.location_timezone", "text": "Main location and timezone", "type": "text", "required": false,
       "sensitivity": "public", "maps_to": {"category": "organization_profile", "key": "location_timezone"}},
      {"id": "exec.website", "text": "Website", "type": "text", "required": false,
       "sensitivity": "public", "maps_to": {"category": "organization_profile", "key": "website"}},
      {"id": "exec.employee_count", "text": "Number of employees", "type": "number", "required": true,
       "maps_to": {"category": "organization_profile", "key": "employee_count"}},
      {"id": "exec.products_services", "text": "Key products and services", "type": "long_text", "required": true,
       "sensitivity": "public", "maps_to": {"category": "products_services", "key": "summary"}},
      {"id": "exec.customer_types", "text": "Primary customer types", "type": "long_text", "required": true,
       "maps_to": {"category": "customer_personas", "key": "summary"}},
      {"id": "exec.decision_maker_role", "text": "Role/title of the owner or decision maker (no names)", "type": "text", "required": true,
       "maps_to": {"category": "roles", "key": "decision_maker"}},
      {"id": "exec.implementation_owner_role", "text": "Role/title of the implementation owner (no names)", "type": "text", "required": false,
       "maps_to": {"category": "roles", "key": "implementation_owner"}},
      {"id": "exec.software_stack", "text": "Current software stack (one per item)", "type": "list", "required": true,
       "maps_to": {"category": "systems", "key": "current_stack"}},
      {"id": "exec.top_pains", "text": "Top 3 business pains", "type": "list", "required": true, "max_items": 3,
       "maps_to": {"category": "pain_points", "key": "top_pains"}},
      {"id": "exec.repetitive_processes", "text": "Top 3 repetitive/manual processes", "type": "list", "required": true, "max_items": 3,
       "maps_to": {"category": "processes", "key": "repetitive_processes"}},
      {"id": "exec.leakage_areas", "text": "Where are leads, customers or tasks lost or delayed?", "type": "long_text", "required": false,
       "maps_to": {"category": "pain_points", "key": "leakage_areas"}},
      {"id": "exec.monthly_leads", "text": "Approx. new leads per month", "type": "number", "required": false,
       "maps_to": {"category": "metrics", "key": "monthly_leads"}},
      {"id": "exec.monthly_support_requests", "text": "Approx. support requests per month", "type": "number", "required": false,
       "maps_to": {"category": "metrics", "key": "monthly_support_requests"}},
      {"id": "exec.monthly_emails", "text": "Approx. business emails handled per month", "type": "number", "required": false,
       "maps_to": {"category": "metrics", "key": "monthly_emails"}},
      {"id": "exec.monthly_appointments", "text": "Approx. appointments/meetings per month", "type": "number", "required": false,
       "maps_to": {"category": "metrics", "key": "monthly_appointments"}},
      {"id": "exec.monthly_transactions", "text": "Approx. transactions/orders per month", "type": "number", "required": false,
       "maps_to": {"category": "metrics", "key": "monthly_transactions"}},
      {"id": "exec.goals", "text": "Business goals for the next 6–12 months", "type": "list", "required": true,
       "maps_to": {"category": "goals", "key": "business_goals"}},
      {"id": "exec.never_without_approval", "text": "Processes AI must never execute without human approval", "type": "list", "required": true,
       "maps_to": {"category": "approval_requirements", "key": "never_without_approval"}},
      {"id": "exec.sensitive_data_categories", "text": "Sensitive/restricted data categories you handle", "type": "multi_choice", "required": true,
       "options": ["none", "customer_pii", "payment_cards", "financial_records", "health", "children", "employee_hr", "legal", "trade_secrets"],
       "maps_to": {"category": "policies", "key": "sensitive_data_categories"}},
      {"id": "exec.tone_of_voice", "text": "Brand tone of voice (e.g. formal, warm, concise)", "type": "text", "required": false,
       "sensitivity": "public", "maps_to": {"category": "tone_brand", "key": "tone_of_voice"}},
      {"id": "exec.knowledge_sources", "text": "Where business knowledge lives (docs, drives, wikis)", "type": "list", "required": false,
       "maps_to": {"category": "knowledge_sources", "key": "locations"}},
      {"id": "exec.focus_areas", "text": "Which areas should we look at?", "type": "multi_choice", "required": true,
       "options": ["sales_crm", "customer_service", "office_admin", "email_calendar", "marketing_social", "operations",
                   "finance", "hr", "management_bi", "knowledge_docs", "integrations_it", "security_compliance"],
       "maps_to": {"category": "goals", "key": "focus_areas"}}
    ]
  },
  "module_template": [
    {"field": "data_sensitivity", "text": "How sensitive is the data in this area?", "type": "single_choice", "required": true,
     "options": ["public", "internal", "confidential", "restricted"], "maps_to": {"category": "policies"}},
    {"field": "current_workflow", "text": "Describe the current workflow, step by step", "type": "long_text", "required": true,
     "maps_to": {"category": "processes"}},
    {"field": "people_involved", "text": "Roles involved (titles, not names)", "type": "list", "required": false,
     "maps_to": {"category": "roles"}},
    {"field": "systems_used", "text": "Systems/tools used in this area", "type": "list", "required": false,
     "maps_to": {"category": "systems"}},
    {"field": "monthly_volume", "text": "Approx. monthly volume (items handled)", "type": "number", "required": false,
     "maps_to": {"category": "metrics"}},
    {"field": "hours_per_week", "text": "Approx. staff hours per week spent on this", "type": "number", "required": false,
     "maps_to": {"category": "metrics"}},
    {"field": "bottlenecks", "text": "Main bottlenecks or pains", "type": "list", "required": true,
     "maps_to": {"category": "pain_points"}},
    {"field": "error_rate_pct", "text": "Error/rework rate in % (if known)", "type": "number", "required": false,
     "maps_to": {"category": "metrics"}},
    {"field": "business_impact", "text": "Business impact of these problems", "type": "single_choice", "required": true,
     "options": ["low", "medium", "high", "critical"], "maps_to": {"category": "pain_points"}},
    {"field": "desired_outcome", "text": "Desired outcome", "type": "long_text", "required": true,
     "maps_to": {"category": "goals"}},
    {"field": "required_approvals", "text": "Steps that must stay under human approval", "type": "list", "required": false,
     "maps_to": {"category": "approval_requirements"}},
    {"field": "kpi", "text": "How would you measure success here (KPI)?", "type": "text", "required": false,
     "maps_to": {"category": "kpis"}}
  ],
  "modules": [
    {"id": "sales_crm", "title": "Sales & CRM",
     "activation": {"any": [
       {"question": "exec.focus_areas", "op": "includes", "value": "sales_crm"},
       {"question": "exec.monthly_leads", "op": "gt", "value": 0}]},
     "capability": {"agent_role": "leads", "availability": "available",
       "capability": "Lead capture, qualification, follow-up and CRM hygiene",
       "base_complexity": "medium", "risk": "medium",
       "default_kpi": "Median lead response time; lead-to-meeting conversion rate"},
     "pain_keywords": ["lead", "sales", "follow up", "follow-up", "crm", "quote", "deal", "prospect", "conversion"],
     "volume_question": "exec.monthly_leads",
     "extra_questions": [
       {"field": "lead_sources", "text": "Where do leads come from?", "type": "list", "required": true,
        "maps_to": {"category": "processes"}},
       {"field": "response_time_hours", "text": "Typical time to first response to a new lead (hours)", "type": "number", "required": false,
        "maps_to": {"category": "metrics"}},
       {"field": "crm_system", "text": "CRM system in use (if any)", "type": "text", "required": false,
        "maps_to": {"category": "systems"}}
     ]},
    {"id": "customer_service", "title": "Customer Service",
     "activation": {"any": [
       {"question": "exec.focus_areas", "op": "includes", "value": "customer_service"},
       {"question": "exec.monthly_support_requests", "op": "gt", "value": 0}]},
     "capability": {"agent_role": "support", "availability": "planned",
       "capability": "First-line support triage and answers from the approved knowledge base",
       "base_complexity": "medium", "risk": "medium",
       "default_kpi": "First response time; % requests resolved without escalation"},
     "pain_keywords": ["support", "customer service", "complaint", "ticket", "response time", "whatsapp", "service"],
     "volume_question": "exec.monthly_support_requests",
     "extra_questions": [
       {"field": "channels", "text": "Support channels", "type": "multi_choice", "required": true,
        "options": ["whatsapp", "phone", "email", "web_chat", "social", "in_person"], "maps_to": {"category": "processes"}},
       {"field": "first_response_hours", "text": "Typical first response time (hours)", "type": "number", "required": false,
        "maps_to": {"category": "metrics"}},
       {"field": "top_request_types", "text": "Most common request types", "type": "list", "required": true,
        "maps_to": {"category": "processes"}}
     ]},
    {"id": "office_admin", "title": "Office / Admin",
     "activation": {"any": [{"question": "exec.focus_areas", "op": "includes", "value": "office_admin"}]},
     "capability": {"agent_role": "office_admin", "availability": "planned",
       "capability": "Back-office admin: data entry, document preparation, reminders and routing",
       "base_complexity": "low", "risk": "low",
       "default_kpi": "Admin hours per week; document turnaround time"},
     "pain_keywords": ["admin", "paperwork", "document", "data entry", "filing", "manual entry", "forms"],
     "extra_questions": [
       {"field": "admin_tasks", "text": "Recurring admin tasks", "type": "list", "required": true,
        "maps_to": {"category": "processes"}},
       {"field": "document_types", "text": "Document types handled", "type": "list", "required": false,
        "maps_to": {"category": "processes"}}
     ]},
    {"id": "email_calendar", "title": "Email & Calendar",
     "activation": {"any": [
       {"question": "exec.focus_areas", "op": "includes", "value": "email_calendar"},
       {"question": "exec.monthly_appointments", "op": "gt", "value": 0}]},
     "capability": {"agent_role": "calendar", "availability": "available",
       "capability": "Scheduling, reminders and inbox triage",
       "base_complexity": "low", "risk": "medium",
       "default_kpi": "Time to book a meeting; no-show rate"},
     "pain_keywords": ["email", "inbox", "calendar", "schedule", "meeting", "appointment", "booking"],
     "volume_question": "exec.monthly_appointments",
     "extra_questions": []},
    {"id": "marketing_social", "title": "Marketing / Social",
     "activation": {"any": [{"question": "exec.focus_areas", "op": "includes", "value": "marketing_social"}]},
     "capability": {"agent_role": "instagram", "availability": "available",
       "capability": "Content planning, captions and scheduled social publishing",
       "base_complexity": "medium", "risk": "medium",
       "default_kpi": "Posts published per week; engagement rate"},
     "pain_keywords": ["marketing", "social", "instagram", "content", "post", "campaign", "brand"],
     "extra_questions": []},
    {"id": "operations", "title": "Operations",
     "activation": {"any": [{"question": "exec.focus_areas", "op": "includes", "value": "operations"}]},
     "capability": {"agent_role": "operations", "availability": "planned",
       "capability": "Workflow orchestration, status tracking and exception alerts",
       "base_complexity": "high", "risk": "medium",
       "default_kpi": "Cycle time; exceptions per week"},
     "pain_keywords": ["operations", "inventory", "delivery", "logistics", "order", "supplier", "production"],
     "volume_question": "exec.monthly_transactions",
     "extra_questions": []},
    {"id": "finance", "title": "Finance (workflow only)",
     "activation": {"any": [
       {"question": "exec.focus_areas", "op": "includes", "value": "finance"},
       {"question": "exec.monthly_transactions", "op": "gt", "value": 0}]},
     "capability": {"agent_role": "finance_ops", "availability": "planned",
       "capability": "Finance workflow support (drafting, reconciliation prep, reminders) — no autonomous transactions",
       "base_complexity": "high", "risk": "high",
       "default_kpi": "Days sales outstanding; month-end close time"},
     "pain_keywords": ["invoice", "payment", "billing", "accounting", "collection", "expense", "finance", "cash"],
     "volume_question": "exec.monthly_transactions",
     "extra_questions": []},
    {"id": "hr", "title": "HR",
     "activation": {"any": [{"question": "exec.focus_areas", "op": "includes", "value": "hr"}]},
     "capability": {"agent_role": "hr", "availability": "planned",
       "capability": "Recruiting coordination, onboarding checklists and policy Q&A",
       "base_complexity": "medium", "risk": "high",
       "default_kpi": "Time to hire; onboarding completion time"},
     "pain_keywords": ["hiring", "recruit", "employee", "onboarding", "hr", "staff", "payroll"],
     "extra_questions": []},
    {"id": "management_bi", "title": "Management / BI",
     "activation": {"any": [{"question": "exec.focus_areas", "op": "includes", "value": "management_bi"}]},
     "capability": {"agent_role": "bi_reporting", "availability": "planned",
       "capability": "Automated KPI reporting and management summaries",
       "base_complexity": "medium", "risk": "low",
       "default_kpi": "Time to produce weekly report; report adoption"},
     "pain_keywords": ["report", "dashboard", "kpi", "visibility", "data", "analytics", "forecast"],
     "extra_questions": []},
    {"id": "knowledge_docs", "title": "Knowledge / Documents",
     "activation": {"any": [{"question": "exec.focus_areas", "op": "includes", "value": "knowledge_docs"}]},
     "capability": {"agent_role": "knowledge", "availability": "planned",
       "capability": "Searchable knowledge base and document Q&A over approved sources",
       "base_complexity": "medium", "risk": "medium",
       "default_kpi": "Time to find an answer; repeated internal questions"},
     "pain_keywords": ["knowledge", "procedure", "sop", "wiki", "find information", "training"],
     "extra_questions": []},
    {"id": "integrations_it", "title": "Integrations & IT",
     "activation": {"any": [
       {"question": "exec.focus_areas", "op": "includes", "value": "integrations_it"},
       {"question": "exec.software_stack", "op": "count_gte", "value": 5}]},
     "capability": {"agent_role": "integrations", "availability": "planned",
       "capability": "System integration and data synchronisation between existing tools",
       "base_complexity": "high", "risk": "medium",
       "default_kpi": "Manual copy-paste steps removed; sync error rate"},
     "pain_keywords": ["integration", "sync", "copy paste", "duplicate", "systems don't talk", "it"],
     "extra_questions": []},
    {"id": "security_compliance", "title": "Security / Permissions / Compliance",
     "activation": {"any": [
       {"question": "exec.focus_areas", "op": "includes", "value": "security_compliance"},
       {"question": "exec.sensitive_data_categories", "op": "includes_any",
        "value": ["customer_pii", "payment_cards", "financial_records", "health", "children", "employee_hr", "legal"]}]},
     "capability": {"agent_role": "compliance", "availability": "planned",
       "capability": "Access reviews, policy checks and audit-trail preparation",
       "base_complexity": "high", "risk": "high",
       "default_kpi": "Open access-review findings; audit preparation time"},
     "pain_keywords": ["security", "compliance", "privacy", "gdpr", "audit", "permission", "access"],
     "extra_questions": []}
  ]
}
