ANTHROPIC_API_KEY=sk-ant-...
# JWT auth (replaces bearer token in production)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Legacy bearer token (kept for local dev WebSocket fallback)
BEARER_TOKEN=change-me-to-a-strong-random-token
BEARER_TOKEN_PREV=                         # set during rotation; clear after all clients migrate
DEV_MODE=true
BIND_HOST=127.0.0.1
BIND_PORT=8000
APPROVAL_MODE=smart                        # off | smart | manual
TOOL_BLOCKLIST=                            # comma-separated tool names to hard-block
# Instagram / Meta Graph API (Phase 3+)
META_APP_ID=                               # from your Meta app at developers.facebook.com
META_APP_SECRET=                           # from the same Meta app
META_REDIRECT_URI=http://localhost:8000/api/instagram/oauth/callback
IG_TOKEN_ENC_KEY=                          # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MEDIA_BASE_URL=                            # public base URL where post media is served (Phase 4 publishing)
GEMINI_API_KEY=                            # Google AI Studio key — post-media image generation (Phase 5)
