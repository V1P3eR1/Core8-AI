ANTHROPIC_API_KEY=sk-ant-...
# JWT auth (replaces bearer token in production)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Legacy bearer token (kept for local dev WebSocket fallback)
BEARER_TOKEN=change-me-to-a-strong-random-token
BEARER_TOKEN_PREV=                         # set during rotation; clear after all clients migrate
DEV_MODE=true
BIND_HOST=127.0.0.1
BIND_PORT=8000
APPROVAL_MODE=smart                        # off | smart | manual
TOOL_BLOCKLIST=                            # comma-separated tool names to hard-block
# Instagram / Meta Graph API (Phase 3+)
META_APP_ID=                               # from your Meta app at developers.facebook.com
META_APP_SECRET=                           # from the same Meta app
META_REDIRECT_URI=http://localhost:8000/api/instagram/oauth/callback
IG_TOKEN_ENC_KEY=                          # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MEDIA_BASE_URL=                            # public base URL where post media is served (Phase 4 publishing)
GEMINI_API_KEY=                            # Google AI Studio key — post-media image generation (Phase 5)

# ── Core8AI Social Manager (docs/social-manager/) ─────────────────────────
SOCIAL_TIMEZONE=Asia/Jerusalem
SOCIAL_INSTAGRAM_MODE=mock                 # mock | live  — live must be set explicitly (and demo_mode off in settings)
SOCIAL_LLM_MODE=auto                       # auto | live | mock — auto = live only when ANTHROPIC_API_KEY exists
SOCIAL_LLM_MODEL=claude-sonnet-4-5
SOCIAL_AI_DAILY_TOKEN_BUDGET=400000        # hard stop for AI runs per 24h (tokens)
SOCIAL_AI_MAX_TOKENS_PER_CALL=4096
SOCIAL_RESEARCH_MODE=auto                  # auto | live | mock — live = public RSS feeds, no key needed
SOCIAL_RESEARCH_FEEDS=                     # comma-separated RSS/Atom URLs (defaults: official AI/Meta blogs)
SOCIAL_WORKER_INPROCESS=false              # true = run the worker inside the API (dev only); prod: python -m social.worker
SOCIAL_WORKER_POLL_SECONDS=15
SOCIAL_JOB_LOCK_SECONDS=600
SOCIAL_MISSED_JOB_GRACE_MINUTES=180        # scheduled jobs older than this are marked 'skipped', never run late
SOCIAL_MEDIA_DIR=                          # default backend/media/social (outside the unsigned /media mount)
SOCIAL_MEDIA_SIGNING_KEY=                  # HMAC key for time-limited public media URLs (defaults to JWT_SECRET)
SOCIAL_MEDIA_URL_TTL_SECONDS=7200
SOCIAL_MAX_UPLOAD_MB=300
SOCIAL_NOTIFY_WEBHOOK_URL=                 # optional outbound webhook for alerts (redacted payloads)
SOCIAL_LEAD_WEBHOOK_TOKEN=                 # shared secret for POST /api/social/leads/webhook (website lead form → leads); empty = disabled
SOCIAL_SEED_DEMO=true                      # seed labelled demo records on first boot while demo_mode is on
